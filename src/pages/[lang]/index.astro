---
export function getStaticPaths() {
  return [
    { params: { lang: 'pl' } },
    { params: { lang: 'en' } },
    { params: { lang: 'nl' } },
  ];
}

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const { lang } = Astro.params as { lang: 'pl' | 'en' | 'nl' };

const allPosts = await getCollection('blog', (entry) => {
  return entry.slug.startsWith(`${lang}/`);
});

const sortedPosts = allPosts.sort((a, b) => b.data.datePublished.getTime() - a.data.datePublished.getTime());
---

<BaseLayout title="Home" lang={lang}>
  <!-- Hero Section -->
  <section class="py-12 md:py-20 flex flex-col items-start gap-6 border-b border-slate-800/60">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-teal-500/10 border border-teal-500/20 text-teal-400 text-xs font-mono">
      <span class="w-2 h-2 rounded-full bg-teal-400 animate-pulse"></span>
      Software Architecture & Craftsmanship
    </div>
    
    <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-slate-100 max-w-3xl leading-tight">
      Budujmy lepszy kod i architekturę.
    </h1>
    
    <p class="text-lg md:text-xl text-slate-400 max-w-2xl font-light">
      Cześć! Nazywam się <strong class="text-slate-200">Grzegorz Miernik</strong>. Piszę o TDD, wzorcach projektowych, architekturze systemów oraz doświadczeniach w programowaniu.
    </p>
  </section>

  <!-- Recent Posts Section -->
  <section class="py-12">
    <h2 class="text-2xl font-bold tracking-tight text-slate-100 mb-8">
      Najnowsze artykuły ({lang.toUpperCase()})
    </h2>

    <div class="grid gap-6 md:grid-cols-2">
      {sortedPosts.map((post) => {
        const cleanSlug = post.slug.replace(/^(pl|en|nl)\//, '');
        return (
          <article class="group relative bg-slate-900/50 border border-slate-800/80 rounded-2xl p-6 hover:border-teal-500/40 hover:bg-slate-900/80 transition-all duration-300 flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-2 text-xs text-teal-400 font-mono mb-3">
                <time datetime={post.data.datePublished.toISOString()}>
                  {post.data.datePublished.toLocaleDateString(lang, { year: 'numeric', month: 'short', day: 'numeric' })}
                </time>
              </div>
              <h3 class="text-xl font-bold text-slate-100 group-hover:text-teal-300 transition-colors mb-2">
                <a href={`/${lang}/blog/${cleanSlug}`}>
                  <span class="absolute inset-0"></span>
                  {post.data.title}
                </a>
              </h3>
              <p class="text-slate-400 text-sm line-clamp-3 mb-4">
                {post.data.description}
              </p>
            </div>
            <div class="flex flex-wrap gap-2 mt-4 pt-4 border-t border-slate-800/60">
              {post.data.tags.map((tag) => (
                <span class="text-xs font-mono px-2 py-0.5 rounded bg-slate-800/60 text-slate-300 border border-slate-700/50">
                  #{tag}
                </span>
              ))}
            </div>
          </article>
        );
      })}
    </div>
  </section>
</BaseLayout>
