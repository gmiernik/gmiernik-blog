---
export function getStaticPaths() {
  return [
    { params: { lang: 'pl' } },
    { params: { lang: 'en' } },
    { params: { lang: 'nl' } },
  ];
}

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../../utils/i18n';

const { lang } = Astro.params as { lang: 'pl' | 'en' | 'nl' };
const t = useTranslations(lang);

const allPosts = await getCollection('blog', (entry) => {
  return entry.slug.startsWith(`${lang}/`);
});

const allTags = [...new Set(allPosts.flatMap((post) => post.data.tags))];
---

<BaseLayout title={t('nav.tags')} lang={lang}>
  <section class="py-8 border-b border-slate-800/60 mb-8">
    <h1 class="text-3xl font-extrabold text-slate-100 mb-2">
      {t('nav.tags')}
    </h1>
    <p class="text-slate-400">
      Przeglądaj artykuły według tematu i tagów.
    </p>
  </section>

  <div class="flex flex-wrap gap-3">
    {allTags.map((tag) => (
      <span class="text-sm font-mono px-4 py-2 rounded-xl bg-slate-900 border border-slate-800 text-teal-300 hover:border-teal-500/50 hover:bg-slate-800 transition-all cursor-pointer">
        #{tag}
      </span>
    ))}
  </div>
</BaseLayout>
