---
export function getStaticPaths() {
  return [
    { params: { lang: 'pl' } },
    { params: { lang: 'en' } },
    { params: { lang: 'nl' } },
  ];
}

import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../../../utils/i18n';

const { lang } = Astro.params as { lang: 'pl' | 'en' | 'nl' };
const t = useTranslations(lang);

const allPosts = await getCollection('blog', (entry) => {
  return entry.slug.startsWith(`${lang}/`);
});

const sortedPosts = allPosts.sort((a, b) => b.data.datePublished.getTime() - a.data.datePublished.getTime());
---

<BaseLayout title={t('nav.blog')} lang={lang}>
  <section class="py-8 border-b border-slate-800/60 mb-8">
    <h1 class="text-3xl font-extrabold text-slate-100 mb-2">
      {t('nav.blog')} ({lang.toUpperCase()})
    </h1>
    <p class="text-slate-400">
      Wszystkie opublikowane artykuły i tutoriale z zakresu architektury oprogramowania.
    </p>
  </section>

  <div class="grid gap-6 md:grid-cols-2">
    {sortedPosts.map((post) => {
      const cleanSlug = post.slug.replace(/^(pl|en|nl)\//, '');
      return (
        <article class="group relative bg-slate-900/50 border border-slate-800/80 rounded-2xl p-6 hover:border-teal-500/40 hover:bg-slate-900/80 transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-2 text-xs text-teal-400 font-mono mb-3">
              <time datetime={post.data.datePublished.toISOString()}>
                {post.data.datePublished.toLocaleDateString(lang, { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
            </div>
            <h2 class="text-xl font-bold text-slate-100 group-hover:text-teal-300 transition-colors mb-2">
              <a href={`/${lang}/blog/${cleanSlug}`}>
                <span class="absolute inset-0"></span>
                {post.data.title}
              </a>
            </h2>
            <p class="text-slate-400 text-sm line-clamp-3 mb-4">
              {post.data.description}
            </p>
          </div>
          <div class="flex flex-wrap gap-2 mt-4 pt-4 border-t border-slate-800/60">
            {post.data.tags.map((tag) => (
              <span class="text-xs font-mono px-2 py-0.5 rounded bg-slate-800/60 text-slate-300 border border-slate-700/50">
                #{tag}
              </span>
            ))}
          </div>
        </article>
      );
    })}
  </div>
</BaseLayout>
